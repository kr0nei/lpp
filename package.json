{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lpp",
  "owner": "kr0nei",
  "author": "kr0nei",
  "title": "LPP",
  "description": "bus information from api data.lpp.si",
  "icon": "lpp.png",
  "license": "MIT",
  "commands": [
    {
      "name": "bus",
      "title": "Bus",
      "description": "get latest bus information",
      "mode": "view",
      "subtitle": "",
      "arguments": [
        {
          "name": "postaja",
          "type": "text",
          "placeholder": "Postaja"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.19.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Applications"
  ]
}
